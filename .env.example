APP_NAME=document-anonymizer
ENVIRONMENT=local

TEMP_ROOT=/tmp/anonymizer

MAX_UPLOAD_MB=25
MAX_PDF_PAGES=50
MIN_DIGITAL_TEXT_CHARS=30

STORE_ORIGINAL=false
STORE_REDACTED_TEMP=true
DELETE_TEMP_FILES=true
LOG_PII=false

RESULT_TTL_MINUTES=30

PRESIDIO_SCORE_THRESHOLD=0.55
DEFAULT_REDACTION_MODE=strict

# NER backend: "spacy" (default, es_core_news_md) or "transformers".
# transformers requires: pip install '.[transformers-ner]'
# Falls back to spaCy if the transformer stack/model is unavailable.
NER_ENGINE=spacy
NER_TRANSFORMERS_MODEL=mrm8488/bert-spanish-cased-finetuned-ner
NER_SPACY_MODEL=es_core_news_md
NER_USE_GPU=true

# "auto" tries MinerU first, falls back to easyocr if not installed.
# Explicit: "mineru", "easyocr"
OCR_ENGINE=auto
OCR_USE_GPU=true
OCR_FALLBACK_ENGINE=easyocr

# MinerU2.5-Pro: backend para MinerUClient (mineru-vl-utils)
OCR_MINERU_BACKEND=transformers
# Ruta local al modelo descargado:
#   hf download opendatalab/MinerU2.5-Pro-2604-1.2B --local-dir model/MinerU2.5-Pro-2604-1.2B
OCR_MINERU_MODEL_PATH=model/MinerU2.5-Pro-2604-1.2B

# Post-redaction verification
VERIFY_RISK_THRESHOLD_REVIEW=0.30
VERIFY_RISK_THRESHOLD_REJECT=0.70
VERIFY_LAYERS_STRICT=textual,metadata,binary
# OCR verification layer adds significant processing time — disabled by default
VERIFY_OCR_LAYER_ENABLED=false