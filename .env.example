APP_NAME=document-anonymizer
ENVIRONMENT=local

TEMP_ROOT=/tmp/anonymizer

# Medido: 300 paginas digitales ~5 min; escaneadas, varias horas.
MAX_UPLOAD_MB=200
MAX_PDF_PAGES=300
MIN_DIGITAL_TEXT_CHARS=30

STORE_ORIGINAL=false
STORE_REDACTED_TEMP=true
DELETE_TEMP_FILES=true
LOG_PII=false

# Minutos que se conserva el resultado antes de borrarlo del disco.
RESULT_TTL_MINUTES=360

PRESIDIO_SCORE_THRESHOLD=0.55
DEFAULT_REDACTION_MODE=strict

# NER backend: "spacy" (default, es_core_news_md) or "transformers".
# transformers requires: pip install '.[transformers-ner]'
# Falls back to spaCy if the transformer stack/model is unavailable.
NER_ENGINE=spacy
NER_TRANSFORMERS_MODEL=mrm8488/bert-spanish-cased-finetuned-ner
NER_SPACY_MODEL=es_core_news_md
NER_USE_GPU=true

# "auto" tries MinerU first, falls back to easyocr if not installed.
# Explicit: "mineru", "easyocr"
OCR_ENGINE=auto
OCR_USE_GPU=true
OCR_FALLBACK_ENGINE=easyocr

# MinerU2.5-Pro: backend para MinerUClient (mineru-vl-utils)
OCR_MINERU_BACKEND=transformers
# Ruta local al modelo descargado:
#   hf download opendatalab/MinerU2.5-Pro-2604-1.2B --local-dir data/model/MinerU2.5-Pro-2604-1.2B
OCR_MINERU_MODEL_PATH=data/model/MinerU2.5-Pro-2604-1.2B

# Post-redaction verification
VERIFY_RISK_THRESHOLD_REVIEW=0.30
VERIFY_RISK_THRESHOLD_REJECT=0.70
VERIFY_LAYERS_STRICT=textual,metadata,binary
# OCR verification layer adds significant processing time — disabled by default
VERIFY_OCR_LAYER_ENABLED=false

# --- Trabajos asincronos ----------------------------------------------------
# Documentos procesados a la vez.  Es tambien el numero de trabajadores y el
# limite de acceso a la GPU: con mas de uno, dos peticiones simultaneas de OCR
# agotan la memoria de la tarjeta.
MAX_CONCURRENT_DOCUMENTS=1
# Trabajos admitidos en cola antes de rechazar con 503.
JOB_QUEUE_MAX=20
# Cada cuanto barre el limpiador de trabajos caducados (segundos).
JOB_SWEEP_INTERVAL_S=60

# --- Tras un proxy inverso --------------------------------------------------
# Prefijo del que cuelga la aplicacion (p. ej. /anonimizador).  Vacio si esta
# en la raiz del dominio.  El TLS lo termina el proxy, nunca la aplicacion:
# arrancala con --proxy-headers para que respete X-Forwarded-Proto.
ROOT_PATH=

# --- Modelos locales --------------------------------------------------------
# Carpeta con los pesos de EasyOCR (craft_mlt_25k.pth y latin_g2.pth).  Vacio =
# ~/.EasyOCR/model.  En el servidor de destino puede no haber salida a
# internet: los pesos viajan en la imagen y la descarga se desactiva.
EASYOCR_MODEL_PATH=
EASYOCR_ALLOW_DOWNLOAD=true
