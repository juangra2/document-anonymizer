# Samples / debug output
data/samples/debug_ocr/

# DOCUMENTOS REALES CON DATOS PERSONALES — NO SUBIR NUNCA.
# Los documentos reales de prueba (DNI, expedientes y tomos del ayuntamiento)
# contienen datos personales de personas identificables.  Subirlos al
# repositorio, aunque se borren después, los deja para siempre en el
# historial de git.  Convención: cualquier documento real va en data/samples/real/,
# que está ignorada entera.  Las otras dos líneas son una red por si alguno
# se deja fuera de esa carpeta.  Las tres de samples/ son la ruta antigua: se
# quedan por si alguien la vuelve a crear por costumbre.  No quites estas reglas.
data/samples/real/
data/samples/*real*
data/samples/DNI*
samples/real/
samples/*real*
samples/DNI*

# Artefactos de evaluación que se regeneran solos.  La referencia vigente vive
# en evaluation/reference/ y sí está bajo seguimiento.
evaluation/results*.json
evaluation/report*.html
evaluation/checkpoint*.jsonl
evaluation/*.pdf
evaluation/work*/
# Salidas, puntos de control, resultados e informes de cada corrida, en la raiz de
# evaluation/.  La medicion final esta en evaluation/reference/c4/ (bajo
# seguimiento) y el informe final, que si se sube, se regenera desde ahi.
evaluation/salidas_*/
evaluation/*.jsonl
evaluation/*.json
evaluation/*.html
!evaluation/informe_final.html
input/

# Model weights (large binary files — download separately)
data/model/

# Claude Code internal memory
.claude/

# INE raw downloads (inputs to scripts/build_gazetteers.py; artefacts are committed)
data/ine_raw/

# Casos dificiles inventados: se regeneran con scripts/casos_dificiles.py
data/samples/casos_dificiles/

# Corpus de imagenes y sus salidas: se generan con evaluation/corpus_imagenes.py
evaluation/imagenes/

# Corpus de Word y Excel y sus salidas: se generan con evaluation/corpus_word.py y corpus_excel.py
evaluation/word/
evaluation/excel/
evaluation/excel_dificil/
